# Konfigurasi Lingkungan Delivery Ku (Salin ke .env dan sesuaikan dengan panel InfinityFree)
APP_NAME="Delivery Ku"
APP_ENV=production
APP_DEBUG=false
APP_URL="https://deliveryku.rf.gd"
APP_TIMEZONE="Asia/Jakarta"

# Kredensial Database MySQL (Dapatkan dari Control Panel InfinityFree -> MySQL Databases)
DB_HOST="sql103.infinityfree.com"
DB_PORT="3306"
DB_NAME="if0_43456311_deliveryku"
DB_USER="if0_43456311"
DB_PASS="deliveryku"

# Keamanan Session & CSRF
SESSION_NAME="DELIVERYKU_SESSID"
SESSION_LIFETIME=7200
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
